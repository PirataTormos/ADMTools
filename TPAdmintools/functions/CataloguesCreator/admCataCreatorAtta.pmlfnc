NEW CATEGORY /TPLOC/ATTA/SUP
DESC 'BASIC SUPPORT ATTA'
PURP PIPE
GTYP ATTA
SKEY 'FLOR'

NEW TEXT /TPLOC/ATTA/SUP-PA1
PURP PARA
STEX 'DN'

END
NEW TEXT /TPLOC/ATTA/SUP-PA2
PURP PARA
STEX 'CONN_TYPE'

END
NEW SDTEXT /TPLOC/ATTA/SUP-SDTE
RTEX 'BASIC SUPPORT ATTA'

END
NEW PTSET /TPLOC/ATTA/SUP/PTSE_001

NEW PTAXIS
NUMB 1
PCON PARAM 2
PBOR PARAM 1
PDIS 0
PAXI X

END
NEW PTAXIS
NUMB 2
PCON PARAM 2
PBOR PARAM 1
PDIS 0
PAXI -X

END
NEW PTCAR
NUMB 3
PCON 0
PBOR 0
PX 0
PY ( 0.4 * ATTRIB PARA[1 ] * SIN ( 45 ) )
PZ ( 0.4 * ATTRIB PARA[1 ] * COS ( 45 ) )
PTCDI Y ( 45 ) Z

END
NEW PTCAR
NUMB 4
PCON 0
PBOR 0
PX 0
PY ( - 0.4 * ATTRIB PARA[1 ] * SIN ( 45 ) )
PZ ( 0.4 * ATTRIB PARA[1 ] * COS ( 45 ) )
PTCDI AXIS -Y ( 45 ) Z

END
END
NEW GMSET /TPLOC/ATTA/SUP/GMSE_001

NEW LCYLINDER
TUFL true
PTDI ( 0.8 * ATTRIB PARA[1 ] )
PBDI 0
PDIA 10
PAXI -P3

END
NEW LCYLINDER
TUFL true
PTDI ( 0.8 * ATTRIB PARA[1 ] )
PBDI 0
PDIA 10
PAXI -P4

END
END
