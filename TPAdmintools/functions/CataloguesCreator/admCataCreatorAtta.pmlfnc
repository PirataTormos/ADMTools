define function !!admCataCreatorAtta()


ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW CATALOGUE /ATTA

NEW SECTION /ATTA-COMPONENTS

NEW CATEGORY /CARGIL-FTUB-SOPORTATION
DESC ' Nip, Mnf Std, PE/NPTM End, Seamless, L = 75mm, -,/2.9MM'
GTYP FTUB
SKEY 'FPPL'
CCON SCM

NEW TEXT /CARGIL-FTUB-SOPORTATION-PA1
PURP PARA
STEX 'Nominal Bore'

END
NEW TEXT /CARGIL-FTUB-SOPORTATION-PA2
PURP PARA
STEX 'Length'

END
NEW TEXT /CARGIL-FTUB-SOPORTATION-PA3
PURP PARA
STEX 'Arrival Connection Type'

END
NEW TEXT /CARGIL-FTUB-SOPORTATION-PA4
PURP PARA
STEX 'Leave Connection Type'

END
NEW TEXT /CARGIL-FTUB-SOPORTATION-PA5
PURP PARA
STEX 'Pipe O/D'

END
NEW SDTEXT /CARGIL-FTUB-SOPORTATION-SDTE
SKEY 'TUBE'
RTEX 'Support Mark, please set Mtocomponet off'

END
NEW PTSET /CARGIL-FTUB-SOPORTATION-PTSE

NEW PTAXIS
NUMB 1
PCON PARAM 3
PBOR PARAM 1
PDIS 0
PAXI -X

END
NEW PTAXIS
NUMB 2
PCON PARAM 4
PBOR PARAM 1
PDIS PARAM 2
PAXI X

END
END
NEW GMSET /CARGIL-FTUB-SOPORTATION-GMSE

NEW SCYLINDER
TUFL true
PDIS 0
PDIA ( ATTRIB PARA[5 ] + ATTRIB IPAR[1 ] )
PHEI PARAM 2
PAXI X

END
NEW LINE
OBST 0
CLFL true
SETP P1 P2
DIAM 0.76mm

END
END
NEW DTSET /CARGIL-FTUB-SOPORTATION-DTSE

NEW DATA
DKEY ABOR
PPRO ( ATTRIB PARA[1 ] )
DPRO ( 0 )
PURP PARA
NUMB 1
DTIT 'Nominal Bore'

END
NEW DATA
DKEY LE
PPRO ( ATTRIB PARA[2 ] )
DPRO ( 0 )
PURP PARA
NUMB 2
DTIT 'Length'

END
NEW DATA
DKEY ACON
PPRO ( ATTRIB PARA[3 ] )
DPRO ( 0 )
PURP PARA
NUMB 3
DTIT 'Arrival Connection Type'

END
NEW DATA
DKEY LCON
PPRO ( ATTRIB PARA[4 ] )
DPRO ( 0 )
PURP PARA
NUMB 4
DTIT 'Leave Connection Type'

END
NEW DATA
DKEY PIDI
PPRO ( ATTRIB PARA[5 ] )
DPRO ( 0 )
PURP PARA
NUMB 5
DTIT 'Pipe O/D'

END
END
NEW BTSET /CARGIL-FTUB-SOPORTATION-BTSE

END
