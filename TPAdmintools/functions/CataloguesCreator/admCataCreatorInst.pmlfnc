GTYP INST

NEW DTSET /TPI-00IN0-WF-150LB-DT

NEW DATA /TPI-00IN0-WF-150LB-DT/OVERALL
DESC 'OVERALL DIMENSION'
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 150 )
PURP DESP
NUMB 1
DTIT 'OVERALL DIMENSION'

END
NEW DATA /TPI-00IN0-WF-150LB-DT/DIST-CL
DESC 'DISTANCE TO CL'
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 0 )
PURP DESP
NUMB 2
DTIT 'DISTANCE TO CL'

END
NEW DATA
DKEY OPAN
PTYP ANGL
PPRO ( ATTRIB DESP[3 ] )
DPRO ( 0 )
PURP DESP
NUMB 3
DTIT 'OPERATOR ANGLE'

END
NEW DATA /TPI-00IN0-WF-150LB-DT/DIAMETER-OPERA
DESC 'OPERATOR DIAMETER'
DKEY OPAD
PTYP DIST
PPRO ( ATTRIB DESP[4 ] )
DPRO ( 0 )
PURP DESP
NUMB 4
DTIT 'OPERATOR A DIAMETER  '

END
NEW DATA /TPI-00IN0-WF-150LB-DT/LENGHT-OPERA
DESC 'OPERATOR LENGHT'
DKEY OPAL
PTYP DIST
PPRO ( ATTRIB DESP[5 ] )
DPRO ( 300 )
PURP DESP
NUMB 5
DTIT 'OPERATOR A LENGHT'

END
NEW DATA
DKEY OPBL
PTYP DIST
PPRO ( ATTRIB DESP[7 ] )
DPRO ( 200 )
PURP DESP
NUMB 7
DTIT 'OPERATOR B LENGHT '

END
NEW DATA
DKEY OPBD
PTYP DIST
PPRO ( ATTRIB DESP[8 ] )
DPRO ( 0 )
PURP DESP
NUMB 8
DTIT 'OPERATOR B DIAMETER'

END
NEW DATA
DKEY BOXS
PTYP DIST
PPRO ( ATTRIB DESP[9 ] )
DPRO ( 0 )
PURP DESP
NUMB 9
DTIT 'BOX SIZE'

END
NEW DATA
DKEY FLTH
PPRO ( ATTRIB PARA[7 ] )
DPRO ( 0 )
PURP UNSE
NUMB 21
DTIT 'FLANGE THICKNESS'

END
END
NEW GMSET /TPI-00IN0-WF-150LB-G

NEW SBOX
TUFL true
PX 0
PY 0
PZ ( ATTRIB RPRO DIST )
PXLE ( 0.5 * ATTRIB RPRO BOXS )
PYLE ( 0.5 * ATTRIB RPRO BOXS )
PZLE ( 0.5 * ATTRIB RPRO BOXS )

END
NEW SCYLINDER
OBST 0
TUFL true
PDIA PARAM 6
PHEI PARAM 7
PAXI -P1
NAPP 0

END
NEW SCYLINDER
CLFL true
TUFL true
PDIS unset
PDIA ( 0.25 * ATTRIB RPRO BOXS )
PHEI ( ATTRIB RPRO DIST + 0.35 * ATTRIB RPRO BOXS )
PAXI Z

END
NEW SCYLINDER
TUFL true
PDIS ( 0.7 * ATTRIB PARA[4 ] )
PDIA ( 0.3 * ATTRIB RPRO BOXS )
PHEI PARAM 5
PAXI Z

END
NEW SCYLINDER
CLFL true
TUFL true
PDIS ( 0.25 * ATTRIB RPRO BOXS )
PDIA ( ATTRIB RPRO OPAD )
PHEI ( ATTRIB RPRO OPAL - 0.25 * ATTRIB RPRO BOXS )
PAXI P5

END
NEW SCYLINDER
CLFL true
TUFL true
PDIS ( 0.25 * ATTRIB RPRO BOXS )
PDIA ( ATTRIB RPRO OPBD )
PHEI ( ATTRIB RPRO OPBL - 0.25 * ATTRIB RPRO BOXS )
PAXI -P5

END
NEW SCYLINDER
OBST 0
TUFL true
PDIA PARAM 6
PHEI PARAM 7
PAXI -P2
NAPP 0

END
NEW SCYLINDER
LEVE 8 10
PDIS 0
PDIA PARAM 4
PHEI ( ATTRIB RPRO HEIG )
PAXI -P1
NAPP 0

END
NEW LSNOUT
OBST 0
TUFL true
PTDI ( 0.5 * ATTRIB RPRO HEIG )
PBDI 0
PTDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PBDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PAAX -P2
PBAX Y
POFF 0
NAPP 0

END
NEW LSNOUT
OBST 0
TUFL true
PTDI ( 0.5 * ATTRIB RPRO HEIG )
PBDI 0
PTDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PBDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PAAX -P1
PBAX Y
POFF 0
NAPP 0

END
END
NEW PTSET /TPI-00IN0-WF-150LB-P

NEW PTAXIS
NUMB 1
PCON PARAM 3
PBOR PARAM 1
PDIS ( 0.5 * ATTRIB RPRO HEIG )
PAXI -X

END
NEW PTCAR
NUMB 4
PCON 0
PBOR 0
PX 0
PY 0
PZ ( ATTRIB RPRO DIST )
PTCDI X

END
NEW PTCAR
NUMB 5
PCON 0
PBOR 0
PX 0
PY 0
PZ ( ATTRIB RPRO DIST )
PTCDI X ( - ATTRIB RPRO OPAN ) Y

END
NEW PTAXIS
NUMB 2
PCON PARAM 3
PBOR PARAM 1
PDIS ( 0.5 * ATTRIB RPRO HEIG )
PAXI X

END
NEW PTMIX
NUMB 3
PCON 0
PBOR 0
PX 0
PY 0
PZ ( ATTRIB RPRO DIST )
PAXI Z

END
END
NEW SDTEXT /TPI-00IN0-WF-150LB-D
SKEY 'IIFL'
RTEX 'Generic Instrument Wafer Ends, 150Lb'
STEX 'Generic Instrument Wafer Ends, PN 40'

END
