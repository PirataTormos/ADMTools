DESC 'DISTANCE TO CL'
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 150 )
PURP DESP
NUMB 2
DTIT 'DISTANCE TO CL'

END
NEW DATA
