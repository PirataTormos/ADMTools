NEW CATEGORY /TPI-00TR0-FG-150LB
DESC 'GENERIC TRAMSMITTER.PN10.RF                  '
GTYP INST

NEW DTSET /TPI-00TR0-FG-150LB-DT

NEW DATA
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 250 )
PURP DESP
NUMB 1
DTIT 'DISTANCE TO CL'

END
NEW DATA
DKEY FLTH
PPRO ( ATTRIB PARA[4 ] )
DPRO ( 0 )
PURP UNSE
NUMB 21
DTIT 'FLANGE THICKNESS'

END
END
