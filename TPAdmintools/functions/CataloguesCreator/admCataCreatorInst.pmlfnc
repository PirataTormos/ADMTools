NEW CATEGORY /TPI-00ID0-FG-PN6
DESC 'INDICATOR PN 10 RF'
GTYP INST

NEW DTSET /TPI-00ID0-FG-PN6-DT

NEW DATA
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 137 )
PURP DESP
NUMB 1
DTIT 'INDICATOR HEIGHT'

END
NEW DATA
DKEY INDI
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 124 )
PURP DESP
NUMB 2
DTIT 'INDICATOR DIAMETER'

END
NEW DATA
DKEY FLTH
PPRO ( ATTRIB PARA[7 ] )
DPRO ( 0 )
