NEW SDTEXT /TPI-00ID0-FG-PN6-D
SKEY 'IDFL'
RTEX 'Generic Indicator, Flanged Ends, PN 10'
STEX 'Generic Indicator, Flanged Ends, PN 10'
TTEX ( ATTRIB DTXR + ' / ' + ATTRIB DTXS )

END
