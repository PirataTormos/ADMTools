NEW CATEGORY /TPI-00CVD-WF-600LB
DESC 'GENERIC CONTROL.VALVE.PN 10.RF'
GTYP INST

NEW DTSET /TPI-00CVD-WF-600LB-DT

NEW DATA
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 300 )
PURP DESP
NUMB 1
DTIT 'OVERALL'

END
NEW DATA
DKEY OPDI
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 300 )
PURP DESP
NUMB 2
DTIT 'OPERATOR DIAMETER'

END
NEW DATA
DKEY OPLE
PTYP DIST
PPRO ( ATTRIB DESP[3 ] )
DPRO ( 500 )
PURP DESP
NUMB 3
DTIT 'OPERATOR LENGHT'

END
NEW DATA
DKEY FLTH
PPRO ( ATTRIB PARA[6 ] )
DPRO ( 0 )
PURP UNSE
NUMB 21
DTIT 'FLANGE THICKNESS'

END
END
NEW GMSET /TPI-00CVD-WF-600LB-G

NEW SCYLINDER
PDIS 0
PDIA PARAM 5
PHEI ( - ATTRIB RPRO HEIG )
PAXI P1
NAPP 0

END
NEW SCYLINDER
PDIS 0
PDIA 1.2 TIMES PARAM 2
PHEI ( ATTRIB RPRO HEIG )
PAXI Z
NAPP 0

END
NEW SCYLINDER
PDIS DIFFERENCE 1 76
PDIA ( ATTRIB RPRO OPDI )
PHEI 275
PAXI -P4
NAPP 0

END
NEW SCYLINDER
OBST 1
PDIS DIFFERENCE 1 200
PDIA ( 1.2 * ATTRIB RPRO OPDI )
