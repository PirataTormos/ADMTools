NEW GMSET /TPI-00IN0-FG-PN40-G

NEW SBOX
TUFL true
PX 0
PY 0
PZ ( ATTRIB RPRO DIST )
PXLE ( 0.5 * ATTRIB RPRO BOXS )
PYLE ( 0.5 * ATTRIB RPRO BOXS )
PZLE ( 0.5 * ATTRIB RPRO BOXS )

END
NEW SCYLINDER
OBST 0
TUFL true
PDIA PARAM 6
PHEI PARAM 7
PAXI -P1
NAPP 0

END
NEW SCYLINDER
CLFL true
TUFL true
PDIS unset
PDIA ( 0.25 * ATTRIB RPRO BOXS )
PHEI ( ATTRIB RPRO DIST + 0.35 * ATTRIB RPRO BOXS )
PAXI Z

END
NEW SCYLINDER
TUFL true
PDIS ( 0.7 * ATTRIB PARA[4 ] )
PDIA ( 0.3 * ATTRIB RPRO BOXS )
PHEI PARAM 5
PAXI Z

END
NEW SCYLINDER
CLFL true
TUFL true
PDIS ( 0.25 * ATTRIB RPRO BOXS )
PDIA ( ATTRIB RPRO OPAD )
PHEI ( ATTRIB RPRO OPAL - 0.25 * ATTRIB RPRO BOXS )
PAXI P5

END
NEW SCYLINDER
CLFL true
TUFL true
PDIS ( 0.25 * ATTRIB RPRO BOXS )
PDIA ( ATTRIB RPRO OPBD )
PHEI ( ATTRIB RPRO OPBL - 0.25 * ATTRIB RPRO BOXS )
PAXI -P5

END
NEW SCYLINDER
OBST 0
TUFL true
PDIA PARAM 6
PHEI PARAM 7
PAXI -P2
NAPP 0

END
NEW SCYLINDER
OBST 0
TUFL true
PDIS 0
PDIA SUM PARAM 4 IPARAM 1
PHEI PARAM 7
PAXI -P2
NAPP 0

END
NEW SCYLINDER
OBST 0
TUFL true
PDIS 0
PDIA SUM PARAM 4 IPARAM 1
PHEI PARAM 7
PAXI -P1
NAPP 0

END
NEW SCYLINDER
LEVE 8 10
PDIS 0
PDIA PARAM 4
PHEI ( ATTRIB RPRO HEIG )
PAXI -P1
NAPP 0

END
NEW LSNOUT
OBST 0
TUFL true
PTDI ( 0.5 * ATTRIB RPRO HEIG )
PBDI PARAM 7
PTDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PBDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PAAX -P2
PBAX Y
POFF 0
NAPP 0

END
NEW LSNOUT
OBST 0
TUFL true
PTDI ( 0.5 * ATTRIB RPRO HEIG )
PBDI PARAM 7
PTDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PBDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PAAX -P1
