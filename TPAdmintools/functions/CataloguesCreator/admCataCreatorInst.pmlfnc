NEW CATEGORY /TPI-00ONP-WF-150LB
DESC 'GENERIC ON-OFF VALVE PN10 ACT. PNEUMATIC'
GTYP INST

NEW DTSET /TPI-00ONP-WF-150LB-DT

NEW DATA /TPI-00ONP-WF-150LB-DT/OVERALL
DESC 'OVERALL DIMENSION'
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 150 )
PURP DESP
NUMB 1
DTIT 'OVERALL DIMENSION'

END
