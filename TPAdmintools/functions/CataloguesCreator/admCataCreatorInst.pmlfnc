DESC 'GENERIC CORIOLIS PN10 '
GTYP INST

NEW DTSET /TPI-00OCO-FG-PN16-DT

NEW DATA /TPI-00OCO-FG-PN16-DT/OVERALL
DESC 'OVERALL DIMENSION'
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 150 )
PURP DESP
NUMB 1
DTIT 'OVERALL DIMENSION'

END
NEW DATA /TPI-00OCO-FG-PN16-DT/DIST-CL
DESC 'DISTANCE TO CL'
