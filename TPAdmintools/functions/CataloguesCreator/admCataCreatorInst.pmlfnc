NEW CATEGORY /TPI-00ID0-FG-600LB
DESC 'INDICATOR PN 10 RF'
GTYP INST

NEW DTSET /TPI-00ID0-FG-600LB-DT

NEW DATA
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 137 )
PURP DESP
NUMB 1
DTIT 'INDICATOR HEIGHT'

END
NEW DATA
DKEY INDI
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 124 )
PURP DESP
NUMB 2
DTIT 'INDICATOR DIAMETER'

END
NEW DATA
DKEY FLTH
PPRO ( ATTRIB PARA[7 ] )
DPRO ( 0 )
PURP UNSE
NUMB 21
DTIT 'FLANGE THICNESS'

END
END
NEW SDTEXT /TPI-00ID0-FG-600LB-D
SKEY 'IDFL'
RTEX 'Instrument'
STEX 'Generic Indicator, Flanged Ends, PN 40'
TTEX ( ATTRIB DTXR + ' / ' + ATTRIB DTXS )

END
NEW PTSET /TPI-00ID0-FG-600LB-P

NEW PTAXIS
NUMB 1
PCON PARAM 2
PBOR PARAM 1
PDIS 0
PAXI -Z

END
NEW PTAXIS
NUMB 2
PCON PARAM 3
PBOR PARAM 1
PDIS PARAM 5
PAXI Z

END
NEW PTMIX
NUMB 3
PCON 0
PBOR 0
PX unset
PY 0
PZ ( ATTRIB RPRO DIST )
PAXI X

END
END
NEW GMSET /TPI-00ID0-FG-600LB-G

NEW SCYLINDER
TUFL true
PDIS 0
PDIA PARAM 8
PHEI PARAM 9
PAXI Z
NAPP 0

END
NEW SCYLINDER
TUFL true
PDIS PARAM 9
PDIA PARAM 6
PHEI PARAM 7
