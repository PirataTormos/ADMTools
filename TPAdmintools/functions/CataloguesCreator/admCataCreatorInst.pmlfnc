NEW CATEGORY /TPI-00ONP-FG-PN16
DESC 'GENERIC ON-OFF VALVE PN10 ACT. PNEUMATIC'
GTYP INST

NEW DTSET /TPI-00ONP-FG-PN16-DT

NEW DATA /TPI-00ONP-FG-PN16-DT/OVERALL
DESC 'OVERALL DIMENSION'
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 150 )
PURP DESP
NUMB 1
DTIT 'OVERALL DIMENSION'

END
NEW DATA /TPI-00ONP-FG-PN16-DT/DIST-CL
DESC 'DISTANCE TO CL'
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 150 )
PURP DESP
NUMB 2
DTIT 'DISTANCE TO CL'

END
NEW DATA
