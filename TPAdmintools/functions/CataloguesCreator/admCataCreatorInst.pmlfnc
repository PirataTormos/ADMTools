NEW CATEGORY /TPI-00IN0-WF-PN10
DESC 'GENERIC INSTRUMENT PN 16 RF ACT. PNEUMATIC'
GTYP INST

NEW DTSET /TPI-00IN0-WF-PN10-DT

NEW DATA /TPI-00IN0-WF-PN10-DT/OVERALL
DESC 'OVERALL DIMENSION'
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 150 )
PURP DESP
NUMB 1
DTIT 'OVERALL DIMENSION'

END
