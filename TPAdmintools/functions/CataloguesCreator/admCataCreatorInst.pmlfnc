NEW CATEGORY /TPI-00OCO-WF-600LB
DESC 'GENERIC CORIOLIS PN10 '
GTYP INST

NEW DTSET /TPI-00OCO-WF-600LB-DT

NEW DATA /TPI-00OCO-WF-600LB-DT/OVERALL
DESC 'OVERALL DIMENSION'
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 150 )
PURP DESP
NUMB 1
DTIT 'OVERALL DIMENSION'

END
NEW DATA /TPI-00OCO-WF-600LB-DT/DIST-CL
DESC 'DISTANCE TO CL'
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 150 )
PURP DESP
NUMB 2
DTIT 'DISTANCE TO CL'

END
NEW DATA
