NAPP 0

END
NEW SCYLINDER
TUFL true
PDIS ( ATTRIB PARA[9 ] + ATTRIB PARA[7 ] )
PDIA PARAM 4
PHEI ( ATTRIB PARA[5 ] - ATTRIB PARA[9 ] - ATTRIB PARA[7 ] )
PAXI Z
NAPP 0

END
NEW SCYLINDER
TUFL true
PDIS PARAM 5
PDIA ( ATTRIB PARA[4 ] * 0.65 )
PHEI ( ATTRIB PARA[5 ] * 0.15 )
PAXI Z
NAPP 0

END
NEW LSNOUT
TUFL true
PTDI ( ATTRIB RPRO DIST )
PBDI ( ATTRIB PARA[5 ] + ATTRIB PARA[5 ] * 0.15 )
PTDM ( ATTRIB PARA[4 ] * 0.25 )
PBDM ( ATTRIB PARA[4 ] * 0.85 )
PAAX Z
PBAX Y
POFF 0
NAPP 0

END
NEW LSNOUT
TUFL true
PTDI ( ATTRIB PARA[12 ] - ATTRIB PARA[11 ] )
PBDI 0
PTDM ( ATTRIB PARA[10 ] * 0.35 )
PBDM ( ATTRIB PARA[4 ] * 0.25 )
PAAX P3
PBAX Y
POFF 0
NAPP 0

END
NEW SCYLINDER
TUFL true
PDIS ( ATTRIB PARA[12 ] - ATTRIB PARA[11 ] )
PDIA ( ATTRIB RPRO INDI )
PHEI PARAM 11
PAXI P3
NAPP 0

END
NEW SSPHERE
TUFL true
PDIS 0
PDIA ( ATTRIB PARA[4 ] * 0.75 )
PAXI P3
NAPP 0

END
END
