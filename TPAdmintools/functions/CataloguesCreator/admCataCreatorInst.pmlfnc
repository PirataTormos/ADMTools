OBST 0
TUFL true
PDIS 0
PDIA SUM PARAM 4 IPARAM 1
PHEI PARAM 5
PAXI -P2
NAPP 0

END
NEW SCYLINDER
OBST 0
TUFL true
PDIS 0
PDIA SUM PARAM 4 IPARAM 1
PHEI PARAM 5
PAXI -P1
NAPP 0

END
NEW SCYLINDER
LEVE 8 10
PDIS 0
PDIA PARAM 4
PHEI ( ATTRIB RPRO HEIG )
PAXI -P1
NAPP 0

END
NEW LSNOUT
OBST 0
TUFL true
PTDI ( 0.5 * ATTRIB RPRO HEIG )
PBDI PARAM 7
PTDM ( 0.5 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PBDM ( 0.75 * ATTRIB PARA[4 ] + ATTRIB IPAR[1 ] )
PAAX -P2
PBAX Y
POFF 0
NAPP 0

END
NEW LSNOUT
