NEW CATEGORY /TPI-00ONP-WF-PN6
DESC 'GENERIC ON-OFF VALVE PN10 ACT. PNEUMATIC'
GTYP INST

NEW DTSET /TPI-00ONP-WF-PN6-DT

NEW DATA /TPI-00ONP-WF-PN6-DT/OVERALL
DESC 'OVERALL DIMENSION'
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 150 )
PURP DESP
NUMB 1
DTIT 'OVERALL DIMENSION'

END
NEW DATA /TPI-00ONP-WF-PN6-DT/DIST-CL
DESC 'DISTANCE TO CL'
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 150 )
PURP DESP
NUMB 2
DTIT 'DISTANCE TO CL'

END
NEW DATA
DKEY OPAN
PTYP ANGL
PPRO ( ATTRIB DESP[3 ] )
DPRO ( 0 )
PURP DESP
NUMB 3
DTIT 'OPERATOR ANGLE'

END
NEW DATA /TPI-00ONP-WF-PN6-DT/DIAMETER-OPERA
DESC 'OPERATOR DIAMETER'
DKEY OPAD
PTYP DIST
PPRO ( ATTRIB DESP[4 ] )
DPRO ( 75 )
PURP DESP
NUMB 4
DTIT 'OPERATOR A DIAMETER  '

END
NEW DATA /TPI-00ONP-WF-PN6-DT/LENGHT-OPERA
DESC 'OPERATOR LENGHT'
