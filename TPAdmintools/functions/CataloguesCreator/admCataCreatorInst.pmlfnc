NEW SECTION /Generic_Indicator

NEW CATEGORY /TPI-00ID0-SWM
DESC 'INDICATOR SCREWED'
GTYP INST

NEW DTSET /TPI-00ID0-SWM-DT

NEW DATA
DKEY DIST
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 127 )
PURP DESP
NUMB 1
DTIT 'INDICATOR HEIGHT'

END
NEW DATA
DKEY INDI
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 124 )
PURP DESP
NUMB 2
DTIT 'INDICATOR DIAMETER'

END
END
NEW SDTEXT /TPI-00ID0-SWM-D
SKEY 'IDPL'
RTEX 'Instrument'
TTEX 'INDICATOR SCREWED'

END
NEW PTSET /TPI-00ID0-SWM-P

NEW PTAXIS
NUMB 1
PCON PARAM 2
PBOR PARAM 1
PDIS 0
PAXI -Z

END
NEW PTAXIS
NUMB 2
PCON PARAM 3
PBOR PARAM 1
PDIS PARAM 5
PAXI Z

END
NEW PTMIX
NUMB 3
PCON 0
PBOR 0
PX unset
PY 0
PZ ( ATTRIB RPRO DIST )
PAXI X

END
END
NEW GMSET /TPI-00ID0-SWM-G

NEW SCYLINDER
TUFL true
PDIS 0
PDIA PARAM 4
PHEI ( ATTRIB PARA[5 ] - ATTRIB PARA[9 ] )
PAXI Z
NAPP 0

END
NEW SCYLINDER
TUFL true
PDIS PARAM 5
PDIA ( ATTRIB PARA[4 ] * 0.65 )
PHEI ( ATTRIB PARA[5 ] * 0.15 )
PAXI Z
NAPP 0

END
NEW LSNOUT
TUFL true
PTDI ( ATTRIB RPRO DIST )
PBDI ( ATTRIB PARA[5 ] + ATTRIB PARA[5 ] * 0.15 )
PTDM ( ATTRIB PARA[4 ] * 0.25 )
PBDM ( ATTRIB PARA[4 ] * 0.85 )
PAAX Z
PBAX Y
POFF 0
NAPP 0

END
NEW LSNOUT
TUFL true
PTDI ( ATTRIB PARA[12 ] - ATTRIB PARA[11 ] )
PBDI 0
PTDM ( ATTRIB PARA[10 ] * 0.35 )
PBDM ( ATTRIB PARA[4 ] * 0.25 )
PAAX P3
PBAX Y
POFF 0
NAPP 0

END
NEW SCYLINDER
TUFL true
PDIS ( ATTRIB PARA[12 ] - ATTRIB PARA[11 ] )
PDIA ( ATTRIB RPRO INDI )
PHEI PARAM 11
PAXI P3
NAPP 0

END
NEW SSPHERE
TUFL true
PDIS 0
PDIA ( ATTRIB PARA[4 ] * 0.75 )
PAXI P3
NAPP 0

END
END
