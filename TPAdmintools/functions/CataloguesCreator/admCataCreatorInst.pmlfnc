NEW CATEGORY /TPI-00OCO-FBH-1500LB
DESC 'GENERIC CORIOLIS PN10 '
GTYP INST

NEW DTSET /TPI-00OCO-FBH-1500LB-DT

NEW DATA /TPI-00OCO-FBH-1500LB-DT/OVERALL
DESC 'OVERALL DIMENSION'
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 150 )
PURP DESP
NUMB 1
DTIT 'OVERALL DIMENSION'

END
