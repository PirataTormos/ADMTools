PTYP ANGL
PPRO ( ATTRIB DESP[3 ] )
DPRO ( 0 )
PURP DESP
NUMB 3
DTIT 'OPERATOR ANGLE'

END
NEW DATA /TPI-00ONP-FG-PN16-DT/DIAMETER-OPERA
DESC 'OPERATOR DIAMETER'
DKEY OPAD
PTYP DIST
PPRO ( ATTRIB DESP[4 ] )
DPRO ( 75 )
PURP DESP
NUMB 4
DTIT 'OPERATOR A DIAMETER  '

END
NEW DATA /TPI-00ONP-FG-PN16-DT/LENGHT-OPERA
DESC 'OPERATOR LENGHT'
DKEY OPAL
PTYP DIST
PPRO ( ATTRIB DESP[5 ] )
DPRO ( 300 )
PURP DESP
NUMB 5
DTIT 'OPERATOR A LENGHT'

END
NEW DATA
DKEY OPBL
PTYP DIST
PPRO ( ATTRIB DESP[7 ] )
DPRO ( 200 )
PURP DESP
NUMB 7
DTIT 'OPERATOR B LENGHT '

END
NEW DATA
