DESC 'GENERIC CONTROL.VALVE.PN 10.RF'
GTYP INST

NEW DTSET /TPI-00CVD-FG-300LB-DT

NEW DATA
DKEY HEIG
PTYP DIST
PPRO ( ATTRIB DESP[1 ] )
DPRO ( 300 )
PURP DESP
NUMB 1
DTIT 'OVERALL'

END
NEW DATA
DKEY OPDI
PTYP DIST
PPRO ( ATTRIB DESP[2 ] )
DPRO ( 300 )
PURP DESP
NUMB 2
DTIT 'OPERATOR DIAMETER'

END
NEW DATA
