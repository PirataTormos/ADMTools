define function !!psvboltspco()


    if !!CE.type.eq('SBOL') then

        !spec = !!alert.input('Write the spec in which to generate the SPCO','/')
        if mat(!spec,'/') EQ 0 then
            !spec  = '/' + !spec
        endif
        !bltref = !!CE.name
        !bltseq = !bltref

        if !!tpspecexist(!spec).eq(TRUE) then

            !nonpsvboltsplit = !!CE.name.before('-').split('_')
            !nonpsvbolt = ''
            !tag = !nonpsvboltsplit[4]
            !seq = !!CE.name.after('-')

            do !i from 1 to 5 by 1
                if !i eq 4 then
                    skip
                endif
                !nonpsvbolt = !nonpsvbolt & !nonpsvboltsplit[!i]
                handle (2,752)
                    !!alert.error('this is not a psv bolt')
                endhandle
                if !i eq 5 then
                    skip
                endif
                !nonpsvbolt =  !nonpsvbolt & '_'
            enddo
            !oldspeco = !spec & !nonpsvbolt.before('-')
            !!CE = !oldspeco.dbref()
            var !bore answer of owner of owner
            var !stype1 stype 
            !stype = !stype1 & '_' & !tag & !seq
            var !shop 'FALSE'
            var !catref catref
            var !detref detref
            var !bltref $!bltref
            --!bltref = !bltref + '-$!bltseq'
            $P $!bltref

                SPECONMODE
                OLD SPECIFICATION $!spec
                HEADING                                                                                                                                                                                                 
                TYPE NAME PBOR0 STYP SHOP CATREF DETAIL MATXT CMPREF BLTREF                                                                                                                                             
                DEFAULTS                                                                                                                                                                                                
                - - - = =   
                BOLT *$!bltref $!bore TEXT'$!stype' FALSE $!catref $!detref =0 =0 $!bltref
                handle (17,51)  
                    $P ADMTOOLS: (17,51) - Spcom name /AA3D/73263_10184_1_PSV_SBOL already exists. New Spcom rejected
                    !!alert.error('Spcom name /AA3D/73263_10184_1_PSV_SBOL already exists. New Spcom rejected')

                endhandle
                EXIT
        else       
            !!alert.error('Spec not found')
        endif
    else 

        !!alert.error('Wrong element type')

    endif
    !!CE = !bltref.DBREF()
endfunction

